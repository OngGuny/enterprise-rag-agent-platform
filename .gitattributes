# Auto detect text files and force LF line endings on checkout.
# Reason: cross-platform repo (Linux Docker, macOS dev, Windows dev) — pinning
# LF in the working tree avoids spurious CRLF↔LF diffs and keeps shell scripts
# / Dockerfiles executable on Linux containers.

* text=auto eol=lf

# --- Source code ---
*.py        text eol=lf
*.pyi       text eol=lf
*.pyx       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.jsx       text eol=lf

# --- Config / data ---
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
.dockerignore  text eol=lf

# --- Shell / container ---
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# --- Windows-only scripts keep CRLF ---
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# --- Binary (never normalize) ---
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf
*.pdf       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.tgz       binary
*.7z        binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.parquet   binary
*.pkl       binary
*.pt        binary
*.pth       binary
*.onnx      binary
*.bin       binary
